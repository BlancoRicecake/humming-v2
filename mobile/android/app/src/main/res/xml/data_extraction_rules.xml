<?xml version="1.0" encoding="utf-8"?>
<!-- Backup / device-transfer rules for API 31+ (android:dataExtractionRules).
     Same excludes as backup_rules.xml (see there for the path mapping):
     large, regenerable data must not be uploaded to the user's cloud backup
     nor dragged through a device-to-device transfer. Songs, vocals and
     entitlement state stay included by default. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_flutter/looptap/soundfonts" />
        <exclude domain="root" path="app_flutter/looptap/exports" />
        <exclude domain="file" path="looptap/sf2" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_flutter/looptap/soundfonts" />
        <exclude domain="root" path="app_flutter/looptap/exports" />
        <exclude domain="file" path="looptap/sf2" />
    </device-transfer>
</data-extraction-rules>
