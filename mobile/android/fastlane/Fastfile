require_relative "../../tool/release_support"

default_platform(:android)
ANDROID_DIR = File.join(HumTrackRelease::MOBILE, "android")
AAB_PATH = File.join(HumTrackRelease::MOBILE, "build/app/outputs/bundle/release/app-release.aab")
PLAY_METADATA = File.join(ANDROID_DIR, "fastlane/metadata/android")
PACKAGE_NAME = "com.humtrack.app"

def play_key_path
  path = ENV["GOOGLE_PLAY_JSON_KEY_FILE"] || File.join(HumTrackRelease::ROOT, "backend/secrets/google_play_service_account.json")
  UI.user_error!("Missing HumTrack Play service account JSON") unless File.file?(path)
  path
end

def publish_android(track)
  UI.user_error!("Release AAB is missing") unless File.file?(AAB_PATH)
  production = track == "production"
  upload_to_play_store(
    json_key: play_key_path, package_name: PACKAGE_NAME, track: track, aab: AAB_PATH,
    release_status: "completed", metadata_path: PLAY_METADATA,
    skip_upload_apk: true, skip_upload_metadata: !production,
    skip_upload_changelogs: !production, skip_upload_images: true, skip_upload_screenshots: true,
    changes_not_sent_for_review: false,
    # Surface a required Play Console review step instead of silently leaving a draft.
    rescue_changes_not_sent_for_review: false,
  )
end

platform :android do
  desc "Verify Play access and reject an already used version code"
  lane :doctor do
    _, number = HumTrackRelease.version
    versions = %w[internal alpha beta production].flat_map do |track|
      google_play_track_version_codes(json_key: play_key_path, package_name: PACKAGE_NAME, track: track)
    end
    latest = versions.map(&:to_i).max || 0
    UI.user_error!("Build #{number} must exceed the latest Play track version #{latest}") if number <= latest
    UI.success("Play access verified; latest track version #{latest}, planned version #{number}")
  end

  desc "Build a release AAB with production configuration and an upload key"
  lane :build do |options|
    defines = HumTrackRelease.defines
    HumTrackRelease.require_android_signing!
    version, number = HumTrackRelease.version
    entry = options[:entry] || "lib/main.dart"
    Dir.chdir(HumTrackRelease::MOBILE) do
      sh("flutter", "pub", "get")
      HumTrackRelease.with_defines(defines) do |path|
        sh("flutter", "build", "appbundle", "--release", "--no-pub", "-t", entry,
           "--build-name=#{version}", "--build-number=#{number}", "--dart-define-from-file=#{path}")
      end
    end
  end

  desc "Upload the current release AAB to internal testing"
  lane :upload_internal do
    publish_android("internal")
  end

  desc "Build and publish to internal testing"
  lane :internal do |options|
    doctor
    build(entry: options[:entry] || "lib/main.dart")
    upload_internal
  end

  desc "Build and send a production update with revised store text for review"
  lane :release do
    doctor
    build
    publish_android("production")
  end

  desc "Sync the Play listing without a binary"
  lane :sync_metadata do
    _, number = HumTrackRelease.version
    upload_to_play_store(
      json_key: play_key_path, package_name: PACKAGE_NAME,
      track: "internal", version_code: number, metadata_path: PLAY_METADATA,
      skip_upload_aab: true, skip_upload_apk: true,
      skip_upload_metadata: false, skip_upload_changelogs: false,
      skip_upload_images: true, skip_upload_screenshots: true,
      changes_not_sent_for_review: true,
    )
  end
end