# HumTrack iOS distribution on a local Mac or an ephemeral CI runner.
require "shellwords"
require_relative "../../tool/release_support"

default_platform(:ios)
IOS_DIR = File.join(HumTrackRelease::MOBILE, "ios")
IOS_METADATA = File.join(IOS_DIR, "fastlane/metadata")
APP_IDENTIFIER = "com.humtrack.app"
APPLE_TEAM = "V7XPTJL83T"

def asc_api_key
  missing = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_FILEPATH].select { |key| ENV.fetch(key, "").empty? }
  UI.user_error!("Missing ASC configuration: #{missing.join(', ')}") unless missing.empty?
  path = File.expand_path(ENV.fetch("ASC_KEY_FILEPATH"), IOS_DIR)
  UI.user_error!("App Store Connect private key file is missing") unless File.file?(path)
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"), issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: path, duration: 1200, in_house: false,
  )
end

def prepare_ios_release
  defines = HumTrackRelease.defines
  HumTrackRelease.require_google_plist!
  version, number = HumTrackRelease.version
  UI.message("Building HumTrack #{version} (#{number}); configuration: #{defines.keys.join(', ')}")
  Dir.chdir(HumTrackRelease::MOBILE) do
    sh("flutter", "precache", "--ios")
    sh("flutter", "pub", "get")
    HumTrackRelease.with_defines(defines) do |path|
      sh("flutter", "build", "ios", "--release", "--no-codesign", "--no-pub",
         "--build-name=#{version}", "--build-number=#{number}", "--dart-define-from-file=#{path}")
    end
  end
end

platform :ios do
  desc "Print lanes without requiring credentials"
  lane :hello do
    UI.message("HumTrack iOS: doctor, build, beta, release, submit_release, sync_metadata")
  end

  desc "Verify Apple API access and report the latest uploaded build"
  lane :doctor do
    latest = latest_testflight_build_number(api_key: asc_api_key, app_identifier: APP_IDENTIFIER, initial_build_number: 0)
    UI.success("App Store Connect access verified; latest build #{latest}")
  end

  desc "Build a signed App Store IPA without uploading it"
  lane :build do
    api_key = asc_api_key
    _, number = HumTrackRelease.version
    latest = latest_testflight_build_number(api_key: api_key, app_identifier: APP_IDENTIFIER, initial_build_number: 0)
    UI.user_error!("Build #{number} must exceed the latest uploaded build #{latest}") if number <= latest
    prepare_ios_release
    auth_args = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath", File.expand_path(ENV.fetch("ASC_KEY_FILEPATH"), IOS_DIR),
      "-authenticationKeyID", ENV.fetch("ASC_KEY_ID"),
      "-authenticationKeyIssuerID", ENV.fetch("ASC_ISSUER_ID"),
    ].shelljoin
    build_app(
      workspace: File.join(IOS_DIR, "Runner.xcworkspace"), scheme: "Runner", configuration: "Release",
      export_method: "app-store", export_options: {teamID: APPLE_TEAM, signingStyle: "automatic"},
      output_directory: File.join(HumTrackRelease::MOBILE, "build/export"), output_name: "HumTrack.ipa",
      xcargs: auth_args, clean: false,
      # fastlane adds API authentication to exportArchive itself.
      # Do not duplicate those arguments in export_xcargs.
    )
  end

  desc "Build and upload to TestFlight, waiting for Apple processing"
  lane :beta do
    build
    upload_to_testflight(
      api_key: asc_api_key, app_identifier: APP_IDENTIFIER,
      ipa: File.join(HumTrackRelease::MOBILE, "build/export/HumTrack.ipa"),
      changelog: ENV["TF_CHANGELOG"] || File.read(File.join(IOS_METADATA, "en-US/release_notes.txt")),
      skip_waiting_for_build_processing: false, distribute_external: false, skip_submission: true,
    )
  end

  desc "Submit this exact, already uploaded build with the current store text"
  lane :submit_release do
    version, number = HumTrackRelease.version
    upload_to_app_store(
      api_key: asc_api_key, app_identifier: APP_IDENTIFIER,
      app_version: version, build_number: number.to_s,
      skip_binary_upload: true, skip_screenshots: true, metadata_path: IOS_METADATA,
      submit_for_review: true, automatic_release: ENV["HUMTRACK_AUTOMATIC_RELEASE"] == "true",
      reject_if_possible: ENV["HUMTRACK_REPLACE_PENDING_RELEASE"] == "true",
      force: true, precheck_include_in_app_purchases: false,
    )
  end

  desc "Build, upload, wait for processing, then submit for App Store review"
  lane :release do
    beta
    submit_release
  end

  desc "Sync store text without a binary or review submission"
  lane :sync_metadata do
    deliver(
      api_key: asc_api_key, app_identifier: APP_IDENTIFIER, metadata_path: IOS_METADATA,
      skip_binary_upload: true, skip_screenshots: true, skip_metadata: false,
      force: true, precheck_include_in_app_purchases: false, run_precheck_before_submit: false,
    )
  end

  lane :sync_iap do
    sh("python3", File.join(HumTrackRelease::ROOT, "infra/scripts/asc_create_iap.py"))
  end

  lane :sync_play_iap do
    sh("python3", File.join(HumTrackRelease::ROOT, "infra/scripts/play_create_iap.py"))
  end
end